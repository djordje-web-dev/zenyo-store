# Kopiraj u .env i po zelji promeni vrednosti. Samo za lokalni razvoj.
WP_PORT=8090

DB_NAME=zenyo
DB_USER=zenyo
DB_PASSWORD=promeni-me
DB_ROOT_PASSWORD=promeni-me

WP_ADMIN_USER=admin
WP_ADMIN_PASSWORD=promeni-me
WP_ADMIN_EMAIL=admin@example.com

# Placanje karticama (RaiAccept, Raiffeisen banka). Prazno = kartice se ne prikazuju na naplati.
# Probni nalog: portal.raiaccept.com -> API users. Lozinka se vidi samo jednom.
RAIACCEPT_API_USERNAME=
RAIACCEPT_API_PASSWORD=
# Pravi nalog; stize od banke posle ugovora. Prava placanja se pale sa RAIACCEPT_MODE=production.
RAIACCEPT_PROD_USERNAME=
RAIACCEPT_PROD_PASSWORD=
RAIACCEPT_MODE=sandbox
